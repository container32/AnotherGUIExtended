<?xml version="1.0"?>
<PropertyList>
  <name>AnotherGUIStyle</name>
  <modal>false</modal>
  <layout>vbox</layout>

  <text>
    <label>Select a GUI style</label>
  </text>

  <hrule/>

  <group>
    <layout>vbox</layout>

    <button>
      <legend>Black Glass</legend>
      <equal>true</equal>
      <binding>
        <command>nasal</command>
        <script>setprop("/sim/gui/current-style", 100);</script>
      </binding>
      <binding>
        <command>reinit</command>
        <subsystem>gui</subsystem>
      </binding>
    </button>

    <button>
      <legend>Black Blue Glass</legend>
      <equal>true</equal>
